<?xml version="1.0" encoding="utf-8"?>
<!--
   Vault media lives under noBackupFilesDir; also exclude rootfiles vault paths
   if any are ever placed under filesDir.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="no_backup/vault/" />
    <exclude domain="file" path="vault/" />
</full-backup-content>
